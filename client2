def run_oracle_optimal(found_blocks, user_deadline, sizes, accuracies, variable_speed=False, base_speed=1000000, speed_model="gaussian", rng=None, burst_state=None):
    """Compute the best possible score with perfect foreknowledge of all network speeds (hindsight optimal).
    Uses Dynamic Programming (Pareto-front) to find the truly optimal quality level assignment
    for each block, given known speeds and deadline constraint.
    
    Algorithm: Multiple-choice knapsack solved via Pareto-front DP.
    - Baseline: all blocks at level 1 (minimum time).
    - Budget: deadline minus total L1 time.
    - For each block, 3 options: stay L1 (0 extra), upgrade to L2, upgrade to L3.
    - Maintain Pareto-optimal frontier of (extra_time, extra_score) — guarantees exact optimum."""
    if rng is None:
        rng = np.random.default_rng()
    if burst_state is None:
        burst_state = {"until_next": int(rng.integers(8, 11)), "remaining": 0}
    else:
        burst_state = burst_state.copy()

    n = len(found_blocks)

    # Step 1: Determine the actual speed at each block position (same RNG sequence as other algorithms)
    actual_speeds = []
    current_speed = base_speed
    for i in range(n):
        actual_speeds.append(current_speed)
        if variable_speed and i < n - 1:
            if speed_model == "bursty":
                current_speed = next_bursty_speed(base_speed, burst_state, rng)
            else:
                noise = rng.normal(0, base_speed * 0.1)
                current_speed = max(base_speed * 0.5, base_speed + noise)

    # Step 2: Check if even all level-1 exceeds deadline
    min_time = sum(sizes["1"] / actual_speeds[i] for i in range(n))
    if min_time > user_deadline:
        return 0, True, min_time

    # Step 3: Dynamic Programming — Pareto-front approach for exact optimal
    budget = user_deadline - min_time
    base_score = sum(found_blocks[i]["importance"] * accuracies["1"] for i in range(n))

    # Build upgrade options per block: (extra_time, extra_score) relative to L1
    block_options = []
    for i in range(n):
        imp = found_blocks[i]["importance"]
        speed = actual_speeds[i]
        opts = [
            (0.0, 0.0),  # Stay at L1 (no extra cost)
            ((sizes["2"] - sizes["1"]) / speed, imp * (accuracies["2"] - accuracies["1"])),  # Upgrade to L2
            ((sizes["3"] - sizes["1"]) / speed, imp * (accuracies["3"] - accuracies["1"])),  # Upgrade to L3
        ]
        block_options.append(opts)

    # Pareto-front DP: maintain list of (cumulative_extra_time, cumulative_extra_score)
    # Invariant: sorted by time ascending, scores strictly increasing (non-dominated)
    pareto = [(0.0, 0.0)]

    for opts in block_options:
        new_points = []
        for (t, s) in pareto:
            for (dt, ds) in opts:
                nt = t + dt
                if nt <= budget + 1e-12:  # float tolerance
                    new_points.append((nt, s + ds))

        # Build new Pareto front: sort by time, keep only strictly increasing scores
        new_points.sort()
        pruned = []
        best_score = -1.0
        for (t, s) in new_points:
            if s > best_score + 1e-12:
                pruned.append((t, s))
                best_score = s
        pareto = pruned if pruned else [(0.0, 0.0)]

    best_extra = max(s for (_, s) in pareto)
    total_score = base_score + best_extra
    return total_score, False, user_deadline

def generate_random_blocks(num_blocks=10):
    """Generate random blocks with importance levels"""
    blocks = []
    for i in range(num_blocks):
        blocks.append({
            "hash": f"hash_block_{i}",
            "importance": random.randint(1, 5)
        })
    return blocks

def plot_variance(deadlines, avg_scores, std_scores, color, variance_display):
    """Helper function to plot variance in different styles"""
    if variance_display == "bands":
        plt.fill_between(deadlines, avg_scores - std_scores, avg_scores + std_scores, 
                        color=color, alpha=0.15)
    elif variance_display == "errorbars":
        plt.errorbar(deadlines, avg_scores, yerr=std_scores, fmt='none', 
                    ecolor=color, elinewidth=1, alpha=0.3, capsize=2)
    elif variance_display == "dashed":
        plt.plot(deadlines, avg_scores - std_scores, '--', color=color, alpha=0.3, linewidth=1)
        plt.plot(deadlines, avg_scores + std_scores, '--', color=color, alpha=0.3, linewidth=1)
    elif variance_display == "minmax":
        # For minmax, we need min and max instead of std
        # This will be handled separately in the calling code
        pass


def signal_handler(sig, frame):
    """Handle CTRL+C gracefully"""
    print("\n\nExecution stopped by user (CTRL+C)")
    sys.exit(0)

