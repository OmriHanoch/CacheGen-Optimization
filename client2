def run_dynamic_iterative_channel_aware_sm(found_blocks, user_deadline, sizes, accuracies, log=False, variable_speed=False, base_speed=1000000, speed_model="gaussian", rng=None, burst_state=None, expected_speed=None, ma_window=10, max_sm=90, min_sm=30):
    """Dynamic Iterative with Channel-Aware Adaptive Safety Margin.
    Uses a moving average of recent speeds to estimate pressure:
    1. Calculate time to send all remaining blocks at L1 using MA speed
    2. Compare to remaining time → slack_ratio (0 = no slack, 1 = lots)
    3. SM = min_sm + (max_sm - min_sm) * (1 - slack_ratio)
    
    - Lots of slack (time_left >> time_for_L1): SM ≈ min_sm → aggressive, send high quality
    - No slack (time_left ≈ time_for_L1):      SM ≈ max_sm → conservative, protect deadline
    
    expected_speed: initial MA seed (800K for bursty, 1M otherwise)"""
    if rng is None:
        rng = np.random.default_rng()
    if burst_state is None:
        burst_state = {"until_next": int(rng.integers(8, 11)), "remaining": 0}
    else:
        burst_state = burst_state.copy()
    if expected_speed is None:
        expected_speed = base_speed
    
    simulated_elapsed = 0
    total_score = 0
    history = []
    measured_speed = base_speed
    total_blocks = len(found_blocks)
    
    # Initialize MA with expected_speed (pessimistic for bursty)
    speeds_history = [expected_speed] * ma_window
    
    for i in range(total_blocks):
        time_left = user_deadline - simulated_elapsed
        
        # Moving average of recent speeds
        ma_speed = sum(speeds_history) / len(speeds_history)
        
        # Conservative planning speed: use the worse of current and MA
        planning_speed = min(measured_speed, ma_speed)
        
        # How long to send ALL remaining blocks at L1, according to planning speed?
        remaining_count = total_blocks - i
        time_for_all_L1 = (remaining_count * sizes["1"]) / planning_speed
        
        # Slack = extra time beyond the minimum needed
        slack = time_left - time_for_all_L1
        # slack_ratio: what fraction of remaining time is "extra" (0 = no slack, 1 = lots)
        slack_ratio = max(0.0, min(slack / time_left, 1.0)) if time_left > 0 else 0.0
        
        # Pressure-based SM: low slack → high SM (conservative), high slack → low SM (aggressive)
        adaptive_sm = min_sm + (max_sm - min_sm) * (1.0 - slack_ratio)
        
        # Apply safety margin
        safety_buffer = (time_left * adaptive_sm) / 100
        safe_time_left = time_left - safety_buffer
        
        # Use conservative planning speed (min of current and MA)
        level = calculate_dynamic_step(found_blocks[i:], safe_time_left, planning_speed, sizes)
        
        transmission_time = sizes[level] / measured_speed
        simulated_elapsed += transmission_time
        imp = found_blocks[i]["importance"]
        total_score += (imp * accuracies[level])
        
        if log:
            time_left_after = user_deadline - simulated_elapsed
            remaining_block_count = max(0, total_blocks - (i + 1))
            time_for_remaining_level1 = (remaining_block_count * sizes["1"]) / measured_speed
            remaining_margin = time_left_after - time_for_remaining_level1
            history.append(f"Block {i}: (Imp:{imp}, L:{level}, SM:{adaptive_sm:.1f}%, Slack:{slack_ratio:.2f}, MA:{ma_speed/1000:.0f}K, Speed:{measured_speed/1000:.0f}K, Time:{simulated_elapsed:.4f}s, Margin:{remaining_margin:.4f}s)")
        
        # After transmission, measure the actual network speed and update MA
        if variable_speed and i < total_blocks - 1:
            if speed_model == "bursty":
                measured_speed = next_bursty_speed(base_speed, burst_state, rng)
            else:
                noise = rng.normal(0, base_speed * 0.1)
                measured_speed = max(base_speed * 0.5, base_speed + noise)
            
            # Update moving average
            speeds_history.pop(0)
            speeds_history.append(measured_speed)
    
    failed = simulated_elapsed > user_deadline
    if log:
        return (total_score if not failed else 0, history, failed)
    return (0 if failed else total_score, failed, simulated_elapsed)

