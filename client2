def calculate_dynamic_step(remaining_blocks, time_left, measured_speed, sizes):
    num_rem = len(remaining_blocks)
    current_plan = {i: "1" for i in range(num_rem)}
    
    def get_time(p):
        return sum(sizes[p[idx]] / measured_speed for idx in range(num_rem))

    if get_time(current_plan) > time_left:
        return "1"

    # Iterate by importance across ALL remaining blocks to find the best plan
    for target_imp in range(5, 0, -1):
        for i in range(num_rem):
            if remaining_blocks[i]["importance"] == target_imp:
                plan_copy = current_plan.copy()
                plan_copy[i] = "3"
                if get_time(plan_copy) <= time_left:
                    current_plan[i] = "3"
                    continue
                
                plan_copy[i] = "2"
                if get_time(plan_copy) <= time_left:
                    current_plan[i] = "2"
                    continue
                
    return current_plan[0]

def generate_channel(max_time, base_speed, noise_type, rng):
    """Generate a time-based channel schedule.
    Returns a list of speeds, one per 2ms slot. Returns None for noise_type=1."""
    if noise_type == 1:
        return None
    num_slots = int(max_time / SLOT_DURATION) + 50

    if noise_type == 2:
        # Discrete Markov Chain: 3 states (Good/Medium/Bad)
        speeds = [base_speed * 1.0, base_speed * 0.7, base_speed * 0.4]  # Good, Medium, Bad
        #               → Good  → Medium  → Bad
        transition = [
            [0.85,   0.12,    0.03],   # From Good
            [0.10,   0.80,    0.10],   # From Medium
            [0.20,   0.30,    0.50],   # From Bad
        ]
        state = 0  # Start in Good
        channel = []
        for _ in range(num_slots):
            channel.append(speeds[state])
            r = float(rng.random())
            row = transition[state]
            if r < row[0]:
                state = 0
            elif r < row[0] + row[1]:
                state = 1
            else:
                state = 2
        return channel

    elif noise_type == 3:
        channel = []
        until_next = int(rng.integers(8, 11))
        burst_remaining = 0
        for _ in range(num_slots):
            if burst_remaining > 0:
                channel.append(base_speed * 0.1)
                burst_remaining -= 1
                continue
            until_next -= 1
            if until_next <= 0:
                duration = int(rng.integers(1, 3))
                burst_remaining = duration - 1
                until_next = int(rng.integers(8, 11))
                channel.append(base_speed * 0.1)
            else:
                channel.append(base_speed)
        return channel

    return None

def get_channel_speed(channel, time, base_speed):
    """Get channel speed at a given time."""
    if channel is None:
        return base_speed
    slot_idx = int(time / SLOT_DURATION)
    if slot_idx >= len(channel):
        return channel[-1]
    return channel[slot_idx]

def compute_transmission_time(block_size, start_time, channel, base_speed):
    """Compute actual transmission time crossing slot boundaries.
    Returns (elapsed_time, measured_speed_at_start)."""
    if channel is None:
        return block_size / base_speed, base_speed
    slot_idx = int(start_time / SLOT_DURATION)
    if slot_idx >= len(channel):
        slot_idx = len(channel) - 1
    measured_speed = channel[slot_idx]
    remaining_bits = float(block_size)
    elapsed = 0.0
    # How far into the current slot are we? (0 = slot boundary, up to SLOT_DURATION)
    offset_in_slot = start_time % SLOT_DURATION
    # Time remaining in this slot before the next one starts
    # If we're exactly on a boundary (offset ≈ 0), we have a full slot ahead
    time_in_slot = SLOT_DURATION - offset_in_slot if offset_in_slot > 1e-12 else SLOT_DURATION
    while remaining_bits > 1e-12:
        speed = channel[min(slot_idx, len(channel) - 1)]
        bits_possible = speed * time_in_slot
        if bits_possible >= remaining_bits:
            elapsed += remaining_bits / speed
            remaining_bits = 0
        else:
            remaining_bits -= bits_possible
            elapsed += time_in_slot
            slot_idx += 1
            time_in_slot = SLOT_DURATION
    return elapsed, measured_speed

def _run_iterative_core(found_blocks, user_deadline, sizes, accuracies, log=False, base_speed=1000000, channel=None,
                        strategy="base", safety_margin_percent=0, window_size=10, expected_speed=None, ma_window=10, max_sm=90, min_sm=30):
    """Core simulation loop for all iterative strategies.
    strategy: "base" | "ma" | "static_sm" | "dynamic_sm" | "reverse_sm" | "channel_aware"."""

    simulated_elapsed = 0
    total_score = 0
    history = []
    measured_speed = base_speed
    total_blocks = len(found_blocks)

    # Strategy-specific init: moving-average window
    if strategy in ("ma", "channel_aware"):
        init_speed = (expected_speed or base_speed) if strategy == "channel_aware" else base_speed
        w = ma_window if strategy == "channel_aware" else window_size
        speeds_history = [init_speed] * w

    for i in range(total_blocks):
        time_left = user_deadline - simulated_elapsed
        planning_speed = measured_speed
        safe_time_left = time_left
        log_extra = ""

        if strategy == "ma":
            planning_speed = sum(speeds_history) / len(speeds_history)
            log_extra = f"AvgSpeed:{planning_speed/1000:.0f}Kbps, "

        elif strategy == "static_sm":
            safety_buffer = (time_left * safety_margin_percent) / 100
            safe_time_left = time_left - safety_buffer

        elif strategy == "dynamic_sm":
            remaining_count = total_blocks - i
            dynamic_margin = safety_margin_percent * (remaining_count / total_blocks)
            safety_buffer = (time_left * dynamic_margin) / 100
            safe_time_left = time_left - safety_buffer
            log_extra = f"DynSM:{dynamic_margin:.1f}%, "

        elif strategy == "reverse_sm":
            progress = (i + 1) / total_blocks
            dynamic_margin = safety_margin_percent * progress
            safety_buffer = (time_left * dynamic_margin) / 100
            safe_time_left = time_left - safety_buffer
            log_extra = f"RevSM:{dynamic_margin:.1f}%, "

        elif strategy == "channel_aware":
            ma_speed = sum(speeds_history) / len(speeds_history)
            planning_speed = min(measured_speed, ma_speed)
            remaining_count = total_blocks - i
            time_for_all_L1 = (remaining_count * sizes["1"]) / planning_speed
            slack = time_left - time_for_all_L1
            slack_ratio = max(0.0, min(slack / time_left, 1.0)) if time_left > 0 else 0.0
            adaptive_sm = min_sm + (max_sm - min_sm) * (1.0 - slack_ratio)
            safety_buffer = (time_left * adaptive_sm) / 100
            safe_time_left = time_left - safety_buffer
            log_extra = f"SM:{adaptive_sm:.1f}%, Slack:{slack_ratio:.2f}, MA:{ma_speed/1000:.0f}K, "

        level = calculate_dynamic_step(found_blocks[i:], safe_time_left, planning_speed, sizes)

        tx_time, _ = compute_transmission_time(sizes[level], simulated_elapsed, channel, base_speed)
        simulated_elapsed += tx_time
        imp = found_blocks[i]["importance"]
        total_score += (imp * accuracies[level])

        if log:
            time_left_after = user_deadline - simulated_elapsed
            remaining_block_count = max(0, total_blocks - (i + 1))
            time_for_remaining_level1 = (remaining_block_count * sizes["1"]) / measured_speed
            remaining_margin = time_left_after - time_for_remaining_level1
            history.append(f"Block {i}: (Imp:{imp}, L:{level}, {log_extra}Speed:{measured_speed/1000:.0f}Kbps, Time:{simulated_elapsed:.4f}s, Margin:{remaining_margin:.4f}s)")

        # After transmission, measure the actual network speed
        if channel is not None and i < total_blocks - 1:
            measured_speed = get_channel_speed(channel, simulated_elapsed, base_speed)
            if strategy in ("ma", "channel_aware"):
                speeds_history.pop(0)
                speeds_history.append(measured_speed)

    failed = simulated_elapsed > user_deadline
    if log:
        return (total_score if not failed else 0, history, failed)
    return (0 if failed else total_score, failed, simulated_elapsed)

def run_adaptive(found_blocks, user_deadline, sizes, accuracies, log=False, base_speed=1000000, channel=None):
    simulated_elapsed = 0
    total_score = 0
    history = []
    num_blocks = len(found_blocks)
    measured_speed = base_speed
    
    for i in range(num_blocks):
        time_left = user_deadline - simulated_elapsed
        max_bits = (time_left * measured_speed) / (num_blocks - i) if time_left > 0 else 0
        
        if max_bits >= sizes["3"]: level = "3"
        elif max_bits >= sizes["2"]: level = "2"
        else: level = "1"
        
        tx_time, _ = compute_transmission_time(sizes[level], simulated_elapsed, channel, base_speed)
        simulated_elapsed += tx_time
        imp = found_blocks[i]["importance"]
        total_score += (imp * accuracies[level])
        
        if log:
            # Calculate time to send remaining blocks after current at level 1
            time_left_after = user_deadline - simulated_elapsed
            remaining_block_count = max(0, num_blocks - (i + 1))
            time_for_remaining_level1 = (remaining_block_count * sizes["1"]) / measured_speed
            remaining_margin = time_left_after - time_for_remaining_level1
            history.append(f"Block {i}: (Imp:{imp}, L:{level}, Speed:{measured_speed/1000:.0f}Kbps, Time:{simulated_elapsed:.4f}s, RemainL1:{time_for_remaining_level1:.4f}s, Margin:{remaining_margin:.4f}s)")
        
        # After transmission, measure the actual network speed
        if channel is not None and i < num_blocks - 1:
            measured_speed = get_channel_speed(channel, simulated_elapsed, base_speed)
    
    failed = simulated_elapsed > user_deadline
    if log:
        return (total_score if not failed else 0, history, failed)
    return (0 if failed else total_score, failed, simulated_elapsed)

def run_oracle_optimal(found_blocks, user_deadline, sizes, accuracies, base_speed=1000000, channel=None):
    """Compute the best possible score with perfect foreknowledge of all network speeds (hindsight optimal).
    Uses Dynamic Programming (Pareto-front) to find the truly optimal quality level assignment
    for each block, given known speeds and deadline constraint.
    
    Algorithm: Multiple-choice knapsack solved via Pareto-front DP.
    - Baseline: all blocks at level 1 (minimum time).
    - Budget: deadline minus total L1 time.
    - For each block, 3 options: stay L1 (0 extra), upgrade to L2, upgrade to L3.
    - Maintain Pareto-optimal frontier of (extra_time, extra_score) — guarantees exact optimum."""

    n = len(found_blocks)

    if channel is None:
        # Constant speed mode (noise_type=1)
        speed = base_speed
        min_time = n * sizes["1"] / speed
        if min_time > user_deadline:
            return 0, True, min_time
        budget = user_deadline - min_time
        base_score = sum(found_blocks[i]["importance"] * accuracies["1"] for i in range(n))
        block_options = []
        for i in range(n):
            imp = found_blocks[i]["importance"]
            block_options.append([
                (0.0, 0.0),
                ((sizes["2"] - sizes["1"]) / speed, imp * (accuracies["2"] - accuracies["1"])),
                ((sizes["3"] - sizes["1"]) / speed, imp * (accuracies["3"] - accuracies["1"])),
            ])
        pareto = [(0.0, 0.0)]
        for opts in block_options:
            new_points = []
            for (t, s) in pareto:
                for (dt, ds) in opts:
                    nt = t + dt
                    if nt <= budget + 1e-12:
                        new_points.append((nt, s + ds))
            new_points.sort()
            pruned = []
            best_s = -1.0
            for (t, s) in new_points:
                if s > best_s + 1e-12:
                    pruned.append((t, s))
                    best_s = s
            pareto = pruned if pruned else [(0.0, 0.0)]
        best_point = max(pareto, key=lambda p: p[1])
        return base_score + best_point[1], False, min_time + best_point[0]

    # Channel-aware mode: DP tracking absolute elapsed time
    # Each Pareto point is (elapsed_time, total_score)
    pareto = [(0.0, 0.0)]

    for i in range(n):
        imp = found_blocks[i]["importance"]
        new_points = []
        for (t, s) in pareto:
            for level in ["1", "2", "3"]:
                tx_time, _ = compute_transmission_time(sizes[level], t, channel, base_speed)
                new_t = t + tx_time
                if new_t <= user_deadline + 1e-12:
                    new_points.append((new_t, s + imp * accuracies[level]))

        if not new_points:
            return 0, True, user_deadline

        new_points.sort()
        pruned = []
        best_s = -1.0
        for (t, s) in new_points:
            if s > best_s + 1e-12:
                pruned.append((t, s))
                best_s = s
        pareto = pruned

    best_point = max(pareto, key=lambda p: p[1])
    return best_point[1], False, best_point[0]

def run_layered(found_blocks, user_deadline, sizes, accuracies, log=False, base_speed=1000000, channel=None, decode_time_per_block=0.0005, upgrade_penalty=0.0):
    """Layered (scalable) coding algorithm:
    Phase 1: Send ALL blocks at level 1 (base layer).
    Phase 2: With remaining time before soft deadline, upgrade the most important
             blocks by sending only the delta bits (layer 2 or 3).
    Reserves decode_time_per_block * num_blocks seconds at the end for GPU decoding.
    upgrade_penalty: fraction of extra bits added to delta (0.0 = no penalty, 0.1 = 10% extra)."""

    num_blocks = len(found_blocks)
    decode_reserve = num_blocks * decode_time_per_block
    soft_deadline = user_deadline - decode_reserve
    simulated_elapsed = 0.0
    levels = ["1"] * num_blocks
    history = []
    measured_speed = base_speed

    # Phase 1: Send all blocks at level 1
    for i in range(num_blocks):
        tx_time, _ = compute_transmission_time(sizes["1"], simulated_elapsed, channel, base_speed)
        simulated_elapsed += tx_time
        if channel is not None and i < num_blocks - 1:
            measured_speed = get_channel_speed(channel, simulated_elapsed, base_speed)

    # Phase 2: Greedy upgrades by importance (highest first)
    if simulated_elapsed < soft_deadline:
        sorted_indices = sorted(range(num_blocks), key=lambda idx: (-found_blocks[idx]["importance"], idx))
        for idx in sorted_indices:
            if simulated_elapsed >= soft_deadline:
                break
            # Try upgrade to level 3 (delta from L1)
            delta_3 = (sizes["3"] - sizes["1"]) * (1.0 + upgrade_penalty)
            tx_time_3, _ = compute_transmission_time(delta_3, simulated_elapsed, channel, base_speed)
            if simulated_elapsed + tx_time_3 <= soft_deadline:
                simulated_elapsed += tx_time_3
                levels[idx] = "3"
                if channel is not None:
                    measured_speed = get_channel_speed(channel, simulated_elapsed, base_speed)
                continue
            # Try upgrade to level 2 (delta from L1)
            delta_2 = (sizes["2"] - sizes["1"]) * (1.0 + upgrade_penalty)
            tx_time_2, _ = compute_transmission_time(delta_2, simulated_elapsed, channel, base_speed)
            if simulated_elapsed + tx_time_2 <= soft_deadline:
                simulated_elapsed += tx_time_2
                levels[idx] = "2"
                if channel is not None:
                    measured_speed = get_channel_speed(channel, simulated_elapsed, base_speed)
                continue

    total_score = sum(found_blocks[i]["importance"] * accuracies[levels[i]] for i in range(num_blocks))
    total_elapsed = simulated_elapsed + decode_reserve
    failed = total_elapsed > user_deadline

    if log:
        for i in range(num_blocks):
            history.append(f"Block {i}: (Imp:{found_blocks[i]['importance']}, L:{levels[i]})")
        return (total_score if not failed else 0, history, failed)
    return (0 if failed else total_score, failed, total_elapsed)

def generate_random_blocks(num_blocks=10):
    """Generate random blocks with importance levels"""
    blocks = []
    for i in range(num_blocks):
        blocks.append({
            "hash": f"hash_block_{i}",
            "importance": random.randint(1, 5)
        })
    return blocks

def make_channel(dl, base_speed, noise_type, dl_idx, iteration):
    """Create a deterministic channel for a given (deadline_index, iteration) pair."""
    seed = int((dl_idx * 12345 + iteration * 54321) % (2**31))
    rng_ch = np.random.default_rng(seed)
    return generate_channel(max(dl * 1.5, dl + 0.1), base_speed, noise_type, rng_ch)

def run_sweep(algo_func, blocks, deadlines, sizes, accuracies, base_speed, noise_type, num_iterations, failure_counts=None, success_sums=None, success_counts=None, **algo_kwargs):
    """Run a single algorithm across all deadlines, averaging over noise iterations.
    Returns one score array (averaged over iterations for noisy, direct for deterministic).
    If success_sums/success_counts dicts are provided, tracks cumulative successful scores."""
    if noise_type == 1:
        scores = []
        for dl in deadlines:
            score, failed, _ = algo_func(blocks, dl, sizes, accuracies, base_speed=base_speed, **algo_kwargs)
            scores.append(score)
            dl_key = round(dl, 4)
            if failure_counts is not None and failed:
                failure_counts[dl_key] += 1
            if success_sums is not None and not failed:
                success_sums[dl_key] += score
                success_counts[dl_key] += 1
        return np.array(scores)
    else:
        scores_list = []
        for iteration in range(num_iterations):
            scores = []
            for dl_idx, dl in enumerate(deadlines):
                channel = make_channel(dl, base_speed, noise_type, dl_idx, iteration)
                score, failed, _ = algo_func(blocks, dl, sizes, accuracies, base_speed=base_speed, channel=channel, **algo_kwargs)
                scores.append(score)
                dl_key = round(dl, 4)
                if failure_counts is not None and failed:
                    failure_counts[dl_key] += 1
                if success_sums is not None and not failed:
                    success_sums[dl_key] += score
                    success_counts[dl_key] += 1
            scores_list.append(scores)
        return np.mean(scores_list, axis=0)

def run_multi_sweep(algo_specs, blocks, deadlines, sizes, accuracies, base_speed, noise_type, num_iterations, progress_label=None):
    """Run multiple algorithms on the SAME channel per (deadline, iteration).
    algo_specs: list of dicts with keys 'func', 'kwargs' (optional), 'failure_counts' (optional).
    Returns: list of score arrays (one per algorithm), one per block set."""
    n = len(algo_specs)
    if noise_type == 1:
        all_scores = [[] for _ in range(n)]
        for dl in deadlines:
            dl_key = round(dl, 4)
            for i, spec in enumerate(algo_specs):
                score, failed, elapsed = spec['func'](blocks, dl, sizes, accuracies, base_speed=base_speed, **spec.get('kwargs', {}))
                all_scores[i].append(score)
                fc = spec.get('failure_counts')
                if fc is not None and failed:
                    fc[dl_key] += 1
                ss = spec.get('success_sums')
                if ss is not None and not failed:
                    ss[dl_key] += score
                    spec['success_counts'][dl_key] += 1
                ms = spec.get('margin_sums')
                if ms is not None and not failed:
                    ms[dl_key] += dl - elapsed
                    spec['margin_counts'][dl_key] += 1
        return [np.array(s) for s in all_scores]
    else:
        all_scores_list = [[] for _ in range(n)]
        for iteration in range(num_iterations):
            if progress_label:
                print(f"  {progress_label} {iteration + 1}/{num_iterations}...", end="\r")
            iter_scores = [[] for _ in range(n)]
            for dl_idx, dl in enumerate(deadlines):
                channel = make_channel(dl, base_speed, noise_type, dl_idx, iteration)
                dl_key = round(dl, 4)
                for i, spec in enumerate(algo_specs):
                    score, failed, elapsed = spec['func'](blocks, dl, sizes, accuracies, base_speed=base_speed, channel=channel, **spec.get('kwargs', {}))
                    iter_scores[i].append(score)
                    fc = spec.get('failure_counts')
                    if fc is not None and failed:
                        fc[dl_key] += 1
                    ss = spec.get('success_sums')
                    if ss is not None and not failed:
                        ss[dl_key] += score
                        spec['success_counts'][dl_key] += 1
                    ms = spec.get('margin_sums')
                    if ms is not None and not failed:
                        ms[dl_key] += dl - elapsed
                        spec['margin_counts'][dl_key] += 1
            for i in range(n):
                all_scores_list[i].append(iter_scores[i])
        if progress_label:
            print(f"  Completed!                  ")
        return [np.mean(s, axis=0) for s in all_scores_list]

def plot_variance(deadlines, avg_scores, std_scores, color, variance_display):
    """Helper function to plot variance in different styles"""
    if variance_display == "bands":
        plt.fill_between(deadlines, avg_scores - std_scores, avg_scores + std_scores, 
                        color=color, alpha=0.15)
    elif variance_display == "errorbars":
        plt.errorbar(deadlines, avg_scores, yerr=std_scores, fmt='none', 
                    ecolor=color, elinewidth=1, alpha=0.3, capsize=2)
    elif variance_display == "dashed":
        plt.plot(deadlines, avg_scores - std_scores, '--', color=color, alpha=0.3, linewidth=1)
        plt.plot(deadlines, avg_scores + std_scores, '--', color=color, alpha=0.3, linewidth=1)

def plot_with_variance(deadlines, all_scores, label, color, show_variance, variance_display, avg_override=None, **plot_kwargs):
    """Plot a line with optional variance visualization. Returns the average scores.
    If avg_override is provided, use it instead of computing np.mean (e.g. success-only avg)."""
    avg = avg_override if avg_override is not None else np.mean(all_scores, axis=0)
    plt.plot(deadlines, avg, label=label, color=color, **plot_kwargs)
    if show_variance and avg_override is None:
        if variance_display == "minmax":
            plt.fill_between(deadlines, np.min(all_scores, axis=0), np.max(all_scores, axis=0), color=color, alpha=0.1)
        else:
            plot_variance(deadlines, avg, np.std(all_scores, axis=0), color, variance_display)
    return avg

def signal_handler(sig, frame):
    """Handle CTRL+C gracefully"""
    print("\n\nExecution stopped by user (CTRL+C)")
    sys.exit(0)

def main():
    # Register signal handler for CTRL+C
    signal.signal(signal.SIGINT, signal_handler)
    
    # --- Parse command line arguments ---
    noise_type = 1
    deadline_start = 0.00
    deadline_end = 0.15
    num_blocks = 10
    trace_deadline = None
    log_only = False
    num_block_sets = 10
    num_iterations = 20
    ma_window_size = 10
    ma_window_sizes = "1,2,3,4,5,6"  # Default window sizes for comparison
    safety_margin_percent = 10
    compare_safety_margins = False
