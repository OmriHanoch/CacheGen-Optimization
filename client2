def calculate_dynamic_step(remaining_blocks, time_left, measured_speed, sizes):
    num_rem = len(remaining_blocks)
    current_plan = {i: "1" for i in range(num_rem)}
    
    def get_time(p):
        return sum(sizes[p[idx]] / measured_speed for idx in range(num_rem))

    if get_time(current_plan) > time_left:
        return "1"

    # Iterate by importance across ALL remaining blocks to find the best plan
    for target_imp in range(5, 0, -1):
        for i in range(num_rem):
            if remaining_blocks[i]["importance"] == target_imp:
                plan_copy = current_plan.copy()
                plan_copy[i] = "3"
                if get_time(plan_copy) <= time_left:
                    current_plan[i] = "3"
                    continue
                
                plan_copy[i] = "2"
                if get_time(plan_copy) <= time_left:
                    current_plan[i] = "2"
                    continue
                
    return current_plan[0]

def next_bursty_speed(base_speed, burst_state, rng):
    """Every ~4-6 blocks, drop to 10% capacity for 1-2 blocks."""
    if burst_state["remaining"] > 0:
        burst_state["remaining"] -= 1
        return base_speed * 0.1

    burst_state["until_next"] -= 1
    if burst_state["until_next"] <= 0:
        duration = int(rng.integers(1, 3))  # 1-2 blocks
        burst_state["remaining"] = duration - 1  # current block already dropped
        burst_state["until_next"] = int(rng.integers(8, 11))  # 8-10 blocks
        return base_speed * 0.1

    return base_speed

def run_dynamic_iterative(found_blocks, user_deadline, sizes, accuracies, log=False, variable_speed=False, base_speed=1000000, speed_model="gaussian", rng=None, burst_state=None):
    if rng is None:
        rng = np.random.default_rng()
    if burst_state is None:
        burst_state = {"until_next": int(rng.integers(8, 11)), "remaining": 0}
    else:
        burst_state = burst_state.copy()  # Use a copy so we don't modify the original
    simulated_elapsed = 0
    total_score = 0
    history = []
    measured_speed = base_speed  # Start with assumed 1Mbps
    
    for i in range(len(found_blocks)):
        time_left = user_deadline - simulated_elapsed
        level = calculate_dynamic_step(found_blocks[i:], time_left, measured_speed, sizes)
        
        transmission_time = sizes[level] / measured_speed
        simulated_elapsed += transmission_time
        imp = found_blocks[i]["importance"]
        total_score += (imp * accuracies[level])
        
        if log:
            # Calculate time to send remaining blocks after current at level 1
            time_left_after = user_deadline - simulated_elapsed
            remaining_block_count = max(0, len(found_blocks) - (i + 1))
            time_for_remaining_level1 = (remaining_block_count * sizes["1"]) / measured_speed
            remaining_margin = time_left_after - time_for_remaining_level1
            history.append(f"Block {i}: (Imp:{imp}, L:{level}, Speed:{measured_speed/1000:.0f}Kbps, Time:{simulated_elapsed:.4f}s, Remain-Time:{time_for_remaining_level1:.4f}s, Margin:{remaining_margin:.4f}s)")
        
        # After transmission, measure the actual network speed
        if variable_speed and i < len(found_blocks) - 1:
            if speed_model == "bursty":
                measured_speed = next_bursty_speed(base_speed, burst_state, rng)
            else:
                noise = rng.normal(0, base_speed * 0.1)
                measured_speed = max(base_speed * 0.5, base_speed + noise)
    
    failed = simulated_elapsed > user_deadline
    if log:
        return (total_score if not failed else 0, history, failed)
    return (0 if failed else total_score, failed, simulated_elapsed)

def run_dynamic_iterative_moving_avg(found_blocks, user_deadline, sizes, accuracies, log=False, variable_speed=False, base_speed=1000000, speed_model="gaussian", rng=None, window_size=10, burst_state=None):
    """Dynamic Iterative with moving average of recent speeds"""
    if rng is None:
        rng = np.random.default_rng()
    if burst_state is None:
        burst_state = {"until_next": int(rng.integers(8, 11)), "remaining": 0}
    else:
        burst_state = burst_state.copy()  # Use a copy so we don't modify the original
    simulated_elapsed = 0
    total_score = 0
    history = []
    measured_speed = base_speed
    speeds_history = [base_speed] * window_size  # Initialize with base speed
    
    for i in range(len(found_blocks)):
        time_left = user_deadline - simulated_elapsed
        # Use moving average instead of current speed
        avg_speed = sum(speeds_history) / len(speeds_history)
        level = calculate_dynamic_step(found_blocks[i:], time_left, avg_speed, sizes)
        
        transmission_time = sizes[level] / measured_speed
        simulated_elapsed += transmission_time
        imp = found_blocks[i]["importance"]
        total_score += (imp * accuracies[level])
        
        if log:
            time_left_after = user_deadline - simulated_elapsed
            remaining_block_count = max(0, len(found_blocks) - (i + 1))
            time_for_remaining_level1 = (remaining_block_count * sizes["1"]) / measured_speed
            remaining_margin = time_left_after - time_for_remaining_level1
            history.append(f"Block {i}: (Imp:{imp}, L:{level}, AvgSpeed:{avg_speed/1000:.0f}Kbps, Time:{simulated_elapsed:.4f}s, Remain-Time:{time_for_remaining_level1:.4f}s, Margin:{remaining_margin:.4f}s)")
        
        # After transmission, measure the actual network speed
        if variable_speed and i < len(found_blocks) - 1:
            if speed_model == "bursty":
                measured_speed = next_bursty_speed(base_speed, burst_state, rng)
            else:
                noise = rng.normal(0, base_speed * 0.1)
                measured_speed = max(base_speed * 0.5, base_speed + noise)
            
            # Update moving average
            speeds_history.pop(0)
            speeds_history.append(measured_speed)
    
    failed = simulated_elapsed > user_deadline
    if log:
        return (total_score if not failed else 0, history, failed)
    return (0 if failed else total_score, failed, simulated_elapsed)

